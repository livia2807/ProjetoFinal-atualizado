generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model pessoas {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(255)
  contato  String   @db.VarChar(255)
  email    String   @unique @db.VarChar(255)
  admissao DateTime
  id_setor Int
  id_cargo Int
}

model setores {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(255)
}

model cargos {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(255)
}

model alertas {
  id        Int    @id @default(autoincrement())
  assunto   String @db.VarChar(255)
  id_pessoa Int
}

model denuncias {
  id        Int    @id @default(autoincrement())
  assunto   String @db.VarChar(255)
  id_pessoa Int
  id_setor  Int
}

model gestores {
  id    Int    @id @default(autoincrement())
  nome  String @db.VarChar(255)
  email String @unique @db.VarChar(255)
  senha String @db.VarChar(255)
}