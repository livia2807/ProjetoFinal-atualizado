generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model pessoas {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(255)
  contato  String   @db.VarChar(255)
  email    String   @unique @db.VarChar(255)
  admissao DateTime
  id_setor Int
  id_cargo Int

  @@index([id_cargo], map: "pessoas_id_cargo_fkey")
  @@index([id_setor], map: "pessoas_id_setor_fkey")
}

model setores {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(255)
}

model cargos {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(255)
}

model alertas {
  id        Int    @id @default(autoincrement())
  assunto   String @db.VarChar(255)
  id_pessoa Int

  @@index([id_pessoa], map: "alertas_id_pessoa_fkey")
}

model denuncias {
  id        Int    @id @default(autoincrement())
  assunto   String @db.VarChar(255)
  id_pessoa Int
  id_setor  Int

  @@index([id_pessoa], map: "denuncias_id_pessoa_fkey")
  @@index([id_setor], map: "denuncias_id_setor_fkey")
}

model gestores {
  id    Int    @id @default(autoincrement())
  nome  String @db.VarChar(255)
  email String @unique @db.VarChar(255)
  senha String @db.VarChar(255)
}